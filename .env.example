# Bearer token clients must present to this aggregator's own /mcp and /api/* endpoints.
# Leave unset to auto-generate + persist one on first boot (printed to logs once).
AGGREGATOR_MCP_TOKEN=

# Per-backend auth tokens, referenced by "authEnv" in config.json. Only set the
# ones your config.json actually references.
GSD_BROWSER_TOKEN=
GSD_CLOUD_TOKEN=
HOME_ASSISTANT_TOKEN=
SWITCHBOARD_TOKEN=

# Only used by the Billy-scoped instance (config.billy.example.json)
HOMELABLE_API_KEY=
